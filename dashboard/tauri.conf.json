{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spawnproof",
  "mainBinaryName": "spawnproof-dashboard",
  "version": "0.4.0",
  "identifier": "io.github.gabepurc.spawnproof",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Spawnproof",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' shot: http://shot.localhost; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Spawnproof's dashboard",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
